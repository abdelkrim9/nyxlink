rules_version = '2';
// NYX//LINK — seul le compte de Krimo lit et écrit, et seulement sous users/{son uid}.
// Remplacer UID_DE_KRIMO par l'UID affiché dans Authentication > Users, puis publier
// (console Firebase > Firestore > Règles). Tout le reste est fermé.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && uid == 'UID_DE_KRIMO';
    }
  }
}
