<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Gabarit : install-sync.sh remplace __SCRIPT__ et __LOG__ puis le copie dans ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.krimo.nyxlink-sync</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>__SCRIPT__</string></array>
  <!-- Chaque soir à 22 h ; si le Mac dort, au réveil. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
</dict>
</plist>
